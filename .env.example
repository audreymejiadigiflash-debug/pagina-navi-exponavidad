# Copia este archivo como .env.local (en tu computadora) y llena los valores.
# En Vercel, agrégalos en Project → Settings → Environment Variables.
# Nunca subas .env.local al repositorio.

# Dirección pública de tu tienda (sin "/" al final). En tu computadora: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: solo se usa en el servidor. No la compartas.
SUPABASE_SECRET_KEY=

# Correos que pueden entrar al panel /admin (separados por coma).
# Crea el usuario en Supabase → Authentication → Users → Add user.
ADMIN_EMAILS=tu-correo@ejemplo.com

# Mercado Pago → Tus integraciones → tu aplicación → Credenciales de producción (o de prueba)
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago → Tus integraciones → Webhooks → Clave secreta
MERCADOPAGO_WEBHOOK_SECRET=
